# 复制为 .env 后按需修改（.env 不进 Git，见 .gitignore）
APP_NAME=Enterprise AI Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- PostgreSQL（由 docker compose 启动）----
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=e_ai_database
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5432/e_ai_database

# ---- 测试数据库 ----
TEST_DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5432/e_ai_database_test

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- RQ 异步文档入库 ----
INGEST_QUEUE_NAME=document-ingest
INGEST_JOB_TIMEOUT_SECONDS=900



EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=D:/Tool/Cache/huggingface

# ---- LLM（OpenAI 兼容接口：LM Studio / vLLM / 云端 API）----
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=ornith-1.0-9b # 更换模型处
LLM_API_KEY=lm-studio
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2

# ---- JWT ----
# 本地开发请替换为高强度随机值；不能提交真实生产 Secret。
JWT_SECRET_KEY=change-this-to-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30